# =============================================================================
# Relationship Sourcing Engine - Backend Environment
# Copy this file to `.env` and fill in keys as you obtain them.
# Everything works with stub/mock providers until real keys are provided.
# =============================================================================

# --- Core app ---
APP_NAME="Relationship Sourcing Engine"
ENVIRONMENT=development
# SQLite by default. Swap to postgresql+psycopg://user:pass@host/db for production.
DATABASE_URL=sqlite:///./data/relationship_engine.db
# SQLite journal mode. Leave blank for AUTO (WAL locally; the network-safe
# rollback journal DELETE on Azure /home paths, where WAL corrupts the file).
# Only set this to force a mode, e.g. DELETE.
SQLITE_JOURNAL_MODE=
# Comma-separated list of origins allowed to call the API (the frontend).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public HTTPS base URL for inbound webhooks (e.g. ngrok: https://abc123.ngrok-free.app).
APP_PUBLIC_URL=

# --- Discovery (Apollo-driven ICP search) ---
# Provider: apollo | stub  (stub = offline mock data; ignored when APOLLO_API_KEY is set
# unless FORCE_DISCOVERY_STUB=1, used by seed/smoke scripts)
DISCOVERY_PROVIDER=apollo
# Default page sizes per discovery run (cost control).
DISCOVERY_ORG_LIMIT=25
DISCOVERY_PEOPLE_LIMIT=25
# Default employee_max when a run leaves it blank. 0 = no cap (broadest search).
DISCOVERY_EMPLOYEE_MAX_DEFAULT=0
# Expand Apollo title search to similar titles (broader net, more noise).
APOLLO_INCLUDE_SIMILAR_TITLES=true

# --- Company / contact enrichment ---
# Provider options: stub | apollo | zoominfo
ENRICHMENT_PROVIDER=stub
APOLLO_API_KEY=
APOLLO_BASE_URL=https://api.apollo.io/api/v1
# Max contacts to request per organization from Apollo People Search.
APOLLO_CONTACTS_PER_COMPANY=10
# Auto-reveal emails during discovery/enrichment (uses credits). Default OFF:
# board sourcing reveals only high-fit, human-approved prospects on demand.
APOLLO_REVEAL_CONTACTS=false
# How many top-ranked contacts per organization to reveal emails for (cost control).
APOLLO_ENRICH_CONTACTS_LIMIT=5
# Also reveal personal emails in addition to work emails (uses extra credits).
APOLLO_REVEAL_PERSONAL_EMAILS=false
# Phone numbers are delivered asynchronously to a webhook; needs a public HTTPS URL.
# Default OFF: board outreach is email-first; phone reveals burn extra credits.
APOLLO_REVEAL_PHONE_NUMBER=false
# Optional override. If empty, built as {APP_PUBLIC_URL}/api/webhooks/apollo/phone?token=SECRET
APOLLO_PHONE_WEBHOOK_URL=
APOLLO_PHONE_WEBHOOK_SECRET=
ZOOMINFO_API_KEY=

# --- Board-fit gating (credit control) ---
# Min board-fit score (0-100) required before a prospect's email may be revealed.
# Optional agent automation gate (0 = disabled). When > 0, the autonomous agent
# skips LLM research on contacts whose search-match score is below this value.
# Manual Prospects-page reveals are NEVER blocked by this setting.
BOARD_FIT_REVEAL_THRESHOLD=0
# Drop discovered people below this board-fit during a run (don't save them).
BOARD_FIT_MIN_KEEP=45
# Deprecated — not enforced. Bulk outreach reveals all has_email candidates.
# DISCOVERY_REVEAL_BUDGET=10

# --- AI insight + personalization engine ---
# Provider options: anthropic | stub  (stub = deterministic insights, no API key)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# "Moderate" research: one LLM call per prospect with up to this many quick web
# searches (cost control). 0 disables web search (cheapest).
INSIGHT_WEB_SEARCH_MAX_USES=2
# Only spend LLM research on prospects whose rule-based board-fit (0-100) is at
# least this. People are imported above BOARD_FIT_MIN_KEEP; we research the more
# plausible fits to stay personalized without over-spending.
RESEARCH_GATE_MIN=50
# Legacy; unused by the insight engine.
OPENAI_API_KEY=

# --- Sending cadence (drip) ---
# Auto-send goes out in small batches with a pause between them so the mailbox is
# never blasted (reduces spam/blocking risk). Per-day total is the agent's
# daily_send_cap (set per principal on the Agent page; default 50).
SEND_BATCH_SIZE=10
SEND_BATCH_DELAY_SECONDS=120

# --- Outreach email sending ---
# Provider options: stub | microsoft_graph | outlook | gmail | google | postmark | sendgrid
# For Galaxy / Dalbir's Outlook mailbox, use microsoft_graph (see below).
# For a Google Workspace mailbox (e.g. @tekhqs.ai), use gmail (see below).
EMAIL_PROVIDER=stub
OUTREACH_FROM_EMAIL=dalbir.bains@galaxypharma.net
OUTREACH_FROM_NAME=Dalbir Bains
# Gmail / Google Workspace (used when EMAIL_PROVIDER=gmail). SMTP send + IMAP
# reply tracking via an App Password (requires 2-Step Verification on the
# mailbox; no OAuth). Leave blank to keep the provider inactive.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Microsoft 365 / Outlook — requires Azure app + Mail.Send (application) + admin consent.
# Ask Galaxy IT (Serge) to register the app and share tenant id, client id, secret.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_SEND_AS_USER=dalbir.bains@galaxypharma.net
POSTMARK_SERVER_TOKEN=
SENDGRID_API_KEY=

# --- Multi-mailbox (who each principal sends AS) ---
# A JSON array of selectable mailboxes. When more than one is defined, every
# principal must be bound to one on the Principals page ("Send outreach from")
# — otherwise their campaigns refuse to send rather than going out from the
# wrong person's address.
# OUTREACH_MAILBOXES=[{"id":"galaxy","label":"Dalbir - Galaxy (Outlook)","provider":"microsoft_graph","from_email":"dalbir.bains@galaxypharma.net","from_name":"Dalbir Bains"},{"id":"taha_tekhqs","label":"Taha - tekhqs (Gmail)","provider":"gmail","from_email":"taha.qureshi@tekhqs.ai","from_name":"Taha Qureshi","gmail_app_password":"…"}]
# Fallback mailbox id for non-outreach mail (run digests) only. Prospect
# outreach always uses the principal's own mailbox.
DEFAULT_OUTREACH_MAILBOX_ID=

# --- LinkedIn outreach (Unipile) ---
# Provider options: stub | unipile  (stub never sends — safe default)
LINKEDIN_PROVIDER=stub
# Unipile dashboard → API Keys / Access Token
UNIPILE_API_KEY=
# The connected LinkedIn account id in Unipile to send from.
UNIPILE_ACCOUNT_ID=
# Unipile DSN as host:port (e.g. api28.unipile.com:15824). Base URL = https://{dsn}/api/v1
UNIPILE_DSN=

# --- Voice calling (Vapi + ElevenLabs + Claude) ---
# Provider options: stub | vapi
VOICE_PROVIDER=stub
# Vapi dashboard → Settings → API Keys
VAPI_API_KEY=
# Vapi dashboard → Phone Numbers → copy the Phone Number ID (import Twilio or buy)
VAPI_PHONE_NUMBER_ID=
# Optional: use a saved Vapi assistant instead of transient per-call assistants
VAPI_ASSISTANT_ID=
# ElevenLabs voice id used by Vapi's 11labs provider (default: Rachel)
VAPI_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Shared secret for /api/webhooks/vapi?token=...
VAPI_WEBHOOK_SECRET=
# Add Anthropic + ElevenLabs API keys inside Vapi dashboard → Credentials
# Public URL for Vapi server events (ngrok): APP_PUBLIC_URL=https://xxx.ngrok-free.app
# Legacy (only if importing your own Twilio into Vapi):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ELEVENLABS_API_KEY=

# --- Safety / compliance ---
# Max outreach attempts per organization before requiring manual override.
MAX_OUTREACH_PER_COMPANY=3
# Cooldown days before contacting the same organization again.
OUTREACH_COOLDOWN_DAYS=14
